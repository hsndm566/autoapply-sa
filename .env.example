# AutoApply SA — Railway configuration template
# Copy values into the Railway Service > Variables tab. Never commit a filled copy.

# Railway injects PORT automatically. Do not set it manually.

# ---- Durable files and SQLite state ----
# Requires a Railway Volume mounted at /data/autoapply.
DB_PATH=/data/autoapply/autoapply.db
CV_PATH=/data/autoapply/cv/candidate-cv.pdf

# The legacy engine currently uses this short CV summary to draft. Keep it factual.
CV_TEXT=Industrial Engineering graduate with process-improvement experience.
CANDIDATE_FULL_NAME=Your Name
CANDIDATE_EMAIL=you@example.com
APPLY_NAME=Your Name
APPLY_ROLE=business systems analyst

# ---- Mandatory independent Auditor (Agent 2) ----
# Use a provider distinct from the usual Groq drafting provider.
AUDITOR_PROVIDER=deepseek
AUDITOR_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ---- Drafting and job discovery ----
GROQ_API_KEY=
APIFY_API_KEY=

# ---- Portal execution: keep empty until verified CV file upload exists ----
# The current Auditor intentionally blocks portal runs because the submitter
# does not yet perform a verified input[type=file] CV upload.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ---- Notification (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---- Reserved for a future audited employer-email dispatcher ----
# Do not configure this as a way to bypass the Auditor.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Future authenticated frontend API (not consumed by current service.py) ----
# Add these only when the campaign API and Vercel proxy are implemented.
INTERNAL_SERVICE_TOKEN=
CORS_ALLOW_ORIGIN=https://hsndm.tech
