# Copy variable names into Railway. Keep actual values only in the service environment.
# Railway injects PORT automatically. Do not set it manually.

# ---- Durable campaign storage (requires one Railway volume) ----
DB_PATH=/data/autoapply/autoapply.db
CV_STORAGE_DIR=/data/autoapply/cv
MAX_CV_UPLOAD_BYTES=5242880

# ---- Public campaign API ----
CORS_ORIGIN=https://hsndm.tech
# A long random value. Required for owner-only /run, /kill, and /resume routes.
ADMIN_API_TOKEN=
# A separate long random value for /v1/admin/jobs/import. It has no execution privileges.
JOB_IMPORT_TOKEN=
# Must remain false until a source-specific CV upload proof and Auditor evidence exist.
ALLOW_LEGACY_EXTERNAL_EXECUTION=false
LOG_LEVEL=INFO
WORKER_INTERVAL_SECONDS=300
# Public Greenhouse/Ashby listing discovery only; it stores candidate options and never submits.
CAMPAIGN_DISCOVERY_ENABLED=true
CAMPAIGN_DISCOVERY_INTERVAL_SECONDS=21600

# ---- Read-only Portal Sentinel ----
# Performs bounded GET-only form-shape probes on already-discovered public ATS URLs.
# It never opens a browser, uploads a CV, fills fields, clicks submit, or enables a source.
PORTAL_SENTINEL_ENABLED=true
PORTAL_PROBE_INTERVAL_SECONDS=21600
PORTAL_PROBE_TIMEOUT_SECONDS=12

# ---- Mandatory independent Auditor (Agent 2) ----
AUDITOR_PROVIDER=deepseek
AUDITOR_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ---- Drafting and job discovery ----
GROQ_API_KEY=
APIFY_API_KEY=

# ---- Optional notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---- Audited employer-email dispatcher ----
# No sender may bypass the Auditor or the durable outbox. Leave false until Gmail is configured.
EMAIL_OUTREACH_ENABLED=false
EMAIL_OUTREACH_MAX_PER_CYCLE=5
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Greenhouse browser proof adapter ----
# Must remain false until its offline suite passes and a source-specific activation is reviewed.
ALLOW_GREENHOUSE_LIVE_SUBMISSION=false

# ---- Anchor Browser (Cloud Stealth) ----
# Get this from https://anchorbrowser.io/
ANCHOR_API_KEY=

# ---- Candidate Identity ----
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=

# ---- Bayt profile-aware browser handoff ----
# This confirms that a candidate completed a Bayt profile in their own browser.
# It only exposes queued Bayt leads; it never shares sessions, automates login,
# solves security challenges, or submits an application from Railway.
BAYT_BROWSER_PROFILE_READY=false

# ---- Portal execution remains disabled until source-specific upload proof ----
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
