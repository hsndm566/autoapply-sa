        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var j = $('When Called').first().json || {};\nvar sys = j.system || '';\nvar usr = j.user || '';\nvar mt = (j.max_tokens !== undefined && j.max_tokens !== null && String(j.max_tokens).length) ? Number(j.max_tokens) : 2000;\nif (!mt || isNaN(mt)) mt = 2000;\nvar temp = (j.temperature !== undefined && j.temperature !== null && String(j.temperature).length) ? Number(j.temperature) : 0.6;\nif (isNaN(temp)) temp = 0.6;\nvar messages = [ { role: 'system', content: sys }, { role: 'user', content: usr } ];\nvar groqBody = { model: 'llama-3.3-70b-versatile', temperature: temp, max_tokens: mt, messages: messages };\nvar orBody = { model: 'meta-llama/llama-3.3-70b-instruct', temperature: temp, max_tokens: mt, messages: messages };\nvar zaiBody = { model: 'glm-4.5-flash', temperature: temp, max_tokens: mt, messages: messages };\nreturn [{ json: { system: sys, user: usr, groqBody: groqBody, orBody: orBody, zaiBody: zaiBody } }];"
      }
