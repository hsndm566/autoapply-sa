        "language": "javaScript",
        "jsCode": "var groq = '';\ntry { groq = $('Parse Groq').first().json.text_groq || ''; } catch (e) {}\nvar orr = '';\ntry { orr = $('Parse OpenRouter').first().json.text_or || ''; } catch (e) {}\nvar zai = '';\ntry { zai = $('Parse Z.ai').first().json.text_zai || ''; } catch (e) {}\nfunction valid(s){ s = String(s || '').trim(); return s.length >= 1 ? s : ''; }\nvar cands = [ { t: valid(groq), a: 'groq' }, { t: valid(orr), a: 'openrouter' }, { t: valid(zai), a: 'zai' } ];\nvar best = ''; var provider = 'none';\nfor (var i = 0; i < cands.length; i++) { if (cands[i].t) { best = cands[i].t; provider = cands[i].a; break; } }\nvar ok = !!best;\nreturn [{ json: { text: best, provider: provider, ok: ok } }];"
