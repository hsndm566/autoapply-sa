      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const base = 'https://hsndm566.app.n8n.cloud/api/v1';\nconst targets = [\n  { wf_id: '9xBPxYPpxIEmQdjI', wf_name: 'Job Engine Pro' },\n  { wf_id: 'ruWrLnz5TVYoJRwz', wf_name: 'SiteForge' },\n  { wf_id: 'FNDaY5ZxgKtVQww9', wf_name: 'AI Hub & Health' },\n];\nreturn targets.map(function (t) {\n  return { json: { wf_id: t.wf_id, wf_name: t.wf_name, base_url: base } };\n});"
      }
