    {
      "id": "cb86c6fa-1523-4a19-b2ac-f18cfd95fc65",
      "name": "Decision Engine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const analysis = $('Analyze Status').first().json || {};\nconst web = $input.first().json || {};\nlet webStatus = 0;\nif (web.statusCode !== undefined) webStatus = Number(web.statusCode);\nelse if (web.status !== undefined) webStatus = Number(web.status);\nelse if (web.body !== undefined || web.data !== undefined) webStatus = 200;\nconst workflows = analysis.workflows || [];\nconst unpublished = analysis.unpublished || [];\nconst failing = analysis.failing || [];\n\n// Provider failure signal: AI Hub & Health failing repeatedly is treated as a provider problem.\nconst aiHub = workflows.filter(function (w) { return w.id === 'FNDaY5ZxgKtVQww9'; })[0];\nconst providerTrouble = aiHub && aiHub.consecutive_failures > 3;\n\nlet action = 'none';\nlet target = '';\nlet target_id = '';\nlet provider = '';\nlet alert = false;\n\nif (unpublished.length > 0) {\n  action = 'republish';\n  target = unpublished[0].name;\n  target_id = unpublished[0].id;\n  alert = true;\n} else if (providerTrouble) {\n  action = 'reorder_fallbacks';\n  provider = 'groq';\n  alert = true;\n} else if (webStatus !== 200) {\n  action = 'repush_website';\n  alert = true;\n} else if (failing.length > 0) {\n  action = 'alert';\n  alert = true;\n}\n\nconst aliveProviders = webStatus === 200 ? 'website OK' : 'website DOWN (' + webStatus + ')';\nconst wfLines = workflows.map(function (w) {\n  return (w.active ? 'OK ' : 'DOWN ') + w.name + (w.consecutive_failures > 0 ? (' (' + w.consecutive_failures + ' recent failures)') : '');\n}).join('\\n');\n\nreturn [{ json: {\n  action: action, target: target, target_id: target_id, provider: provider, alert: alert,\n  web_status: webStatus, website_ok: webStatus === 200,\n  workflows: workflows, unpublished_count: unpublished.length, failing_count: failing.length,\n  base_url: 'https://hsndm566.app.n8n.cloud/api/v1',\n  summary_workflows: wfLines, summary_web: aliveProviders,\n} }];"
      }
    },
