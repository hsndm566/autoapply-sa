    {
      "id": "af0673a3-09be-4ea9-9ea0-84e1f931320c",
      "name": "Prep Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        576
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $('Decision Engine').first().json || {};\n// Current hour in Asia/Riyadh (UTC+3)\nconst nowUtc = new Date();\nconst riyadhHour = (nowUtc.getUTCHours() + 3) % 24;\nconst isDigestHour = riyadhHour === 21;\nconst alert = d.alert === true;\nif (!isDigestHour && !alert) { return []; }\n\nlet actionLine;\nswitch (d.action) {\n  case 'republish': actionLine = 'Republished workflow: ' + d.target; break;\n  case 'reorder_fallbacks': actionLine = 'Reordered fallbacks: demoted provider ' + d.provider; break;\n  case 'repush_website': actionLine = 'Re-pushed website index.html (was returning ' + d.web_status + ')'; break;\n  case 'alert': actionLine = 'Flagged: ' + d.failing_count + ' workflow(s) failing repeatedly'; break;\n  default: actionLine = 'All systems nominal';\n}\nconst header = isDigestHour ? 'Autopilot Daily Digest' : 'Autopilot Alert';\nconst lines = [\n  header + ' - ' + new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC',\n  '',\n  'Workflows:',\n  d.summary_workflows || '(none)',\n  '',\n  'Website: ' + d.summary_web,\n  '',\n  'Action this run: ' + actionLine,\n];\nreturn [{ json: { chat_id: '8890901423', message: lines.join('\\n') } }];"
      }
    },
