    {
      "id": "b08cc659-2992-4c5c-83ed-a413489ba259",
      "name": "Analyze Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const targets = $('Build Targets').all();\nlet wfs = [];\nlet exs = [];\ntry { wfs = $('Get Workflow').all(); } catch (e) { wfs = []; }\ntry { exs = $('Get Executions').all(); } catch (e) { exs = []; }\nconst out = [];\nfor (let i = 0; i < targets.length; i++) {\n  const t = targets[i].json || {};\n  const wf = (wfs[i] && wfs[i].json) ? wfs[i].json : {};\n  const exResp = (exs[i] && exs[i].json) ? exs[i].json : {};\n  const active = (wf.active === true);\n  const list = Array.isArray(exResp.data) ? exResp.data : (Array.isArray(exResp) ? exResp : []);\n  let consecutiveFailures = 0;\n  for (let k = 0; k < list.length; k++) {\n    const st = String(list[k].status || (list[k].finished === false ? 'running' : 'success')).toLowerCase();\n    if (st === 'error' || st === 'crashed' || st === 'failed') consecutiveFailures++;\n    else break;\n  }\n  out.push({ name: t.wf_name, id: t.wf_id, active: active, unpublished: !active, consecutive_failures: consecutiveFailures });\n}\nconst unpublished = out.filter(function (w) { return w.unpublished; });\nconst failing = out.filter(function (w) { return w.consecutive_failures > 3; });\nreturn [{ json: { workflows: out, unpublished: unpublished, failing: failing, checked_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "9559ed9b-7b2f-4eb8-9f4a-51c653ce1aaf",
