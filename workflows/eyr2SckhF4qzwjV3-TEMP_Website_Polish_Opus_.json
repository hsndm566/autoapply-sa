        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "var g = $input.item.json || {};\nvar filename = '';\ntry { filename = $('List Files').item.json.filename; } catch (e) { filename = ''; }\nif (!filename) filename = g.name || g.path || '';\nvar sha = g.sha || '';\nvar b64 = g.content || '';\nvar original = '';\ntry { original = Buffer.from(String(b64).replace(/\\n/g, ''), 'base64').toString('utf8'); } catch (e) { original = ''; }\nvar file_ok = !!(filename && sha && original && original.length > 50);\nif (!file_ok) { console.warn('Get File failed or file missing for: ' + (filename || 'unknown')); }\nreturn { json: { filename: filename, original_sha: sha, original_html: original, file_ok: file_ok } };"
      }
