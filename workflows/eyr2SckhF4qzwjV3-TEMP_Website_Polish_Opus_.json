    {
      "id": "82a65b7b-0d55-4090-b03b-5aa344084d12",
      "name": "Prep Commit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "var claude = $input.item.json || {};\nvar dec = {};\ntry { dec = $('Decode File').item.json || {}; } catch (e) { dec = {}; }\nvar filename = dec.filename || '';\nvar sha = dec.original_sha || '';\nvar raw = '';\nif (typeof claude.text === 'string' && claude.text) raw = claude.text;\nelse if (typeof claude.content === 'string') raw = claude.content;\nelse if (Array.isArray(claude.content)) { for (var i = 0; i < claude.content.length; i++) { var p = claude.content[i]; if (p && typeof p.text === 'string') raw += p.text; } }\nelse if (claude.message && typeof claude.message.content === 'string') raw = claude.message.content;\nraw = String(raw || '').trim();\nif (raw.indexOf('```') !== -1) { raw = raw.replace(/```html/gi, '').replace(/```/g, '').trim(); }\nvar low = raw.toLowerCase();\nvar startIdx = low.indexOf('<!doctype');\nif (startIdx === -1) startIdx = low.indexOf('<html');\nif (startIdx > 0) { raw = raw.slice(startIdx); }\nvar endIdx = raw.toLowerCase().lastIndexOf('</html>');\nif (endIdx !== -1) { raw = raw.slice(0, endIdx + 7); }\nraw = raw.trim();\nvar lc = raw.toLowerCase();\nvar valid = (lc.indexOf('<html') !== -1 || lc.indexOf('<!doctype') !== -1) && raw.length >= 200;\nvar push_ok = !!(dec.file_ok && sha && valid);\nvar reason = '';\nif (!dec.file_ok) reason = 'source file missing/unreadable';\nelse if (!valid) reason = 'claude output invalid';\nvar putBody = null;\nif (push_ok) { var cb = Buffer.from(raw, 'utf8').toString('base64'); putBody = { message: 'Polish ' + filename + ' with Claude Opus 4.7', content: cb, sha: sha }; }\nif (!push_ok) { console.warn('Skip push for ' + (filename || 'unknown') + ': ' + reason); }\nreturn { json: { filename: filename, push_ok: push_ok, reason: reason, putUrl: 'https://api.github.com/repos/hsndm566/hsndm.tech/contents/' + filename, putBody: putBody } };"
      }
