    {
      "id": "hc000000-0000-4000-8000-000000000005",
      "name": "Compute Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const clean = (arr) => arr.map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nlet errRows = [];\nlet sysRows = [];\nlet jobRows = [];\ntry { errRows = clean($('Query Errors 24h').all()); } catch (e) {}\ntry { sysRows = clean($('Query SysLogs 24h').all()); } catch (e) {}\ntry { jobRows = clean($('Query Audit Jobs').all()); } catch (e) {}\n\nconst texts = [];\nfor (const r of errRows) { texts.push(String(r.error_message || '')); }\nfor (const r of sysRows) { texts.push(String(r.message || '') + ' ' + String(r.event_type || '') + ' ' + String(r.payload || '')); }\nconst blob = texts.join(' \\n ');\n\nconst countOf = (needle) => {\n  let n = 0;\n  for (const t of texts) { if (t.indexOf(needle) !== -1) n++; }\n  return n;\n};\nconst c429 = countOf('429');\nconst c503 = countOf('503');\nconst c404 = countOf('404');\nconst totalErrors = errRows.length;\nconst totalLogs = sysRows.length;\n\nconst auditTotal = jobRows.length;\nlet auditCompleted = 0;\nfor (const r of jobRows) { if (String(r.status || '') === 'audit_completed') auditCompleted++; }\nconst auditRate = auditTotal > 0 ? (auditCompleted / auditTotal) : 1;\n\n// Thresholds\nconst TH_429 = 5;\nconst TH_503 = 0;\nconst TH_404 = 5;\nconst TH_AUDIT_RATE = 0.8;\n\nconst breaches = [];\nif (c429 > TH_429) breaches.push('HTTP 429 rate high (' + c429 + ' in 24h, threshold ' + TH_429 + ')');\nif (c503 > TH_503) breaches.push('HTTP 503 present (' + c503 + ' in 24h)');\nif (c404 > TH_404) breaches.push('HTTP 404 rate high (' + c404 + ' in 24h, threshold ' + TH_404 + ')');\nif (auditTotal > 0 && auditRate < TH_AUDIT_RATE) breaches.push('Audit verification rate low (' + Math.round(auditRate * 100) + '%, threshold ' + Math.round(TH_AUDIT_RATE * 100) + '%)');\n\nconst breach = breaches.length > 0;\nconst date = $now.toFormat('yyyy-LL-dd HH:mm');\n\nconst numbers = 'Window: last 24h (as of ' + date + ')\\n' +\n  'Errors logged: ' + totalErrors + ' | System logs: ' + totalLogs + '\\n' +\n  'HTTP 429: ' + c429 + ' | 503: ' + c503 + ' | 404: ' + c404 + '\\n' +\n  'Audit verified: ' + auditCompleted + '/' + auditTotal + ' (' + Math.round(auditRate * 100) + '%)';\n\nconst approxNote = 'Note: HTTP status counts are derived from log message text (raw status codes are not stored).';\n\nlet summary_text;\nif (breach) {\n  summary_text = 'HEALTH ALERT\\n\\nBreached:\\n- ' + breaches.join('\\n- ') + '\\n\\n' + numbers + '\\n\\n' + approxNote;\n} else {\n  const okMsg = (totalErrors === 0 && totalLogs === 0) ? 'Daily health OK, no errors in the last 24h.' : 'Daily health OK.';\n  summary_text = okMsg + '\\n\\n' + numbers + '\\n\\n' + approxNote;\n}\n\nreturn [{ json: { c429, c503, c404, total_errors: totalErrors, total_logs: totalLogs, audit_total: auditTotal, audit_completed: auditCompleted, audit_rate: auditRate, breach, breach_reasons: breaches.join('; '), summary_text } }];"
      },
      "onError": "continueRegularOutput"
    },
