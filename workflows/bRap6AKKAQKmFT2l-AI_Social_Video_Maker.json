        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var items = $input.all();\nvar fin = $('Finalize Script').first().json || {};\nvar script = fin.script || '';\nvar topic = fin.topic || '';\nfunction pickLink(resp){ var v=(resp&&resp.videos&&resp.videos[0])||null; if(!v||!Array.isArray(v.video_files)||v.video_files.length===0) return null; var under50=v.video_files.filter(function(f){ return !f.file_size || f.file_size < 50*1024*1024; }); var pool=under50.length?under50:v.video_files; var portrait=pool.filter(function(f){ return (f.height||0)>=(f.width||0); }); var chosen=(portrait.length?portrait:pool).sort(function(a,b){ return (b.height||0)-(a.height||0); })[0]; return chosen?chosen.link:null; }\nvar modifications = { Text: script };\nvar n = 0;\nfor (var i=0;i<items.length;i++){ var link=pickLink(items[i].json); if(link){ n+=1; modifications['Background-'+n]=link; } }\nreturn [{ json: { topic: topic, script: script, ai_source: fin.ai_source || '', modifications: modifications } }];"
      }
