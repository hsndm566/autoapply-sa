    {
      "id": "683e4edb-2c27-44ad-b685-32b43527b141",
      "name": "Prep Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var body = ($json.body || $json) || {};\nvar topic = body.topic || 'General topic';\nvar sys = 'You are an expert short-form video scriptwriter for YouTube Shorts / TikTok / Reels. Given a TOPIC, write a vertical (9:16) short-form voiceover script of about 100 words with three parts: (1) a strong hook in the first line, (2) an informative body that delivers the promised value, and (3) a looping ending that connects back to the hook so the clip loops naturally. Write in a punchy, spoken style with no stage directions, emojis, or markdown. Then generate exactly 8 concise stock-footage visual search terms (2-4 words each) that visually match the script and are likely to exist on stock video sites like Pexels. Return ONLY JSON with keys \"script\" (string) and \"search_terms\" (array of exactly 8 strings). No markdown, no code fences.';\nvar usr = 'Topic: ' + topic;\nreturn [{ json: { topic: topic, sys: sys, usr: usr } }];"
      }
    },
    {
      "id": "hub-call",
      "name": "Generate Script (AI Hub)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
