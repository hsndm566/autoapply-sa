    {
      "id": "extract-script",
      "name": "Extract Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var prep = $('Prep Script').first().json || {};\nvar src = $input.first().json || {};\nvar raw = String(src.text || '');\nvar source = src.provider_used || 'hub';\nfunction clean(s){ s=String(s||'').trim(); if(s.indexOf('\\u0060\\u0060\\u0060')!==-1){ s=s.replace(/\\u0060\\u0060\\u0060json/gi,'').replace(/\\u0060\\u0060\\u0060/g,'').trim(); } return s; }\nfunction parseCand(rawStr){ var c=clean(rawStr); if(!c) return null; var obj=null; try{ obj=JSON.parse(c); }catch(e){ var a=c.indexOf('{'); var b=c.lastIndexOf('}'); if(a!==-1&&b!==-1&&b>a){ try{ obj=JSON.parse(c.slice(a,b+1)); }catch(e2){ obj=null; } } } if(!obj) return null; var script=String(obj.script||'').trim(); var terms=Array.isArray(obj.search_terms)?obj.search_terms.map(function(x){return String(x);}).filter(function(x){return x.length;}):[]; if(script.length<20||terms.length<1) return null; return { script: script, search_terms: terms }; }\nvar p = parseCand(raw);\nvar ok = !!p;\nreturn [{ json: { topic: prep.topic, script: ok?p.script:'', search_terms: ok?p.search_terms:[], ai_source: ok?source:'none', script_ok: ok } }];"
      }
    },
    {
      "id": "05e137c1-0ccd-4b64-a774-f60be52e5190",
      "name": "Finalize Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var m = $input.first().json || {};\nvar prep = $('Prep Script').first().json || {};\nvar topic = prep.topic || m.topic || 'this topic';\nvar script = String(m.script || '').trim();\nvar terms = Array.isArray(m.search_terms) ? m.search_terms.filter(function(x){ return String(x).trim().length; }) : [];\nvar source = m.ai_source || 'none';\nif (script.length < 20 || terms.length < 1) {\n  script = 'Top tips on ' + topic + '. First, master the fundamentals before anything else. Next, apply them consistently every single day. Then measure your results and adjust fast. Small improvements compound into big wins. Follow these tips on ' + topic + ' and watch your results grow.';\n  terms = ['industrial engineering','factory production line','team meeting office','warehouse robots','engineer blueprint','data dashboard','manufacturing workflow','business handshake'];\n  source = 'hardcoded_fallback';\n}\nvar generic = ['industrial engineering','factory production line','team meeting office','warehouse robots','engineer blueprint','data dashboard','manufacturing workflow','business handshake'];\nvar gi = 0;\nwhile (terms.length < 8) { terms.push(generic[gi % generic.length]); gi++; }\nterms = terms.slice(0, 8);\nreturn [{ json: { topic: topic, script: script, search_terms: terms, ai_source: source } }];"
      }
    },
    {
      "id": "7555947d-7d3b-4320-95ff-e7978e3bce22",
