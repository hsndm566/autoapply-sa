    {
      "id": "8c7c0426-0cf9-4f4c-be00-b9f25275fb01",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        48
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nlet text = \"\";\nlet model = \"none\";\n// OpenAI-compatible shape (Groq, NVIDIA, Qwen, DeepSeek, OpenAI)\nif (j.choices && j.choices[0] && j.choices[0].message) {\n  text = j.choices[0].message.content || \"\";\n  model = j.model || \"unknown\";\n// Anthropic shape: { content: [{ type: \"text\", text }], model }\n} else if (Array.isArray(j.content) && j.content[0]) {\n  text = j.content.map(function (b) { return b && b.text ? b.text : \"\"; }).join(\"\");\n  model = j.model || \"unknown\";\n// Already-normalized passthrough\n} else if (typeof j.text === \"string\") {\n  text = j.text;\n  model = j.model_used || \"none\";\n}\nreturn { json: { text: text, model_used: model } };"
      }
    },
