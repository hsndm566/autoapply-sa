{
  "name": "Daily CSV Backup",
  "nodes": [
    {
      "id": "bk000000-0000-4000-8000-000000000001",
      "name": "Daily Midnight",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -820,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "bk000000-0000-4000-8000-000000000002",
      "name": "Read Jobs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -600,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "yrDJL5narftty8xm",
          "cachedResultName": "job_applications"
        },
        "returnAll": true
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "bk000000-0000-4000-8000-000000000003",
      "name": "Convert to CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        -380,
        300
      ],
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "job_applications_backup.csv",
          "headerRow": true
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "bk000000-0000-4000-8000-000000000004",
      "name": "Write to Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        -160,
        300
      ],
      "parameters": {
        "operation": "write",
        "fileName": "/tmp/job_applications_backup.csv",
        "dataPropertyName": "data"
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "bk000000-0000-4000-8000-000000000005",
      "name": "Get Backup Chat ID",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        60,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "JfZedT7wOWXyXgfx",
          "cachedResultName": "bot_config"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "config_key",
              "condition": "eq",
              "keyValue": "telegram_alert_chat_id"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "bk000000-0000-4000-8000-000000000006",
      "name": "Backup Confirmation (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Get Backup Chat ID').first().json.config_value || '8890901423' }}",
        "text": "={{ 'Daily CSV backup ran at ' + $now.toFormat('yyyy-LL-dd HH:mm') + '.\\nRows exported: ' + $('Read Jobs').all().filter(r => Object.keys(r.json).length > 0).length + '\\nPath: /tmp/job_applications_backup.csv\\n\\nCaveat: this instance is n8n Cloud with no retrievable persistent local disk. The file is written to an ephemeral container path and is NOT a durable/retrievable backup. Use an external storage node (S3, Google Drive, etc.) for a real backup.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "vw48hr1C0Ix4VQPK",
          "name": "Telegram Bot"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput",
      "webhookId": "94d8bccb-a872-4e09-b558-32e5c7a6d80f"
    },
    {
      "id": "bk000000-0000-4000-8000-000000000007",
      "name": "Log Backup",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "Qh3DXLSbV0aaLSxS",
          "cachedResultName": "system_logs"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "log_timestamp": "={{ $now.toISO() }}",
            "node_name": "Daily CSV Backup",
            "event_type": "csv_backup",
            "message": "={{ 'CSV backup ran, ' + $('Read Jobs').all().filter(r => Object.keys(r.json).length > 0).length + ' rows to /tmp/job_applications_backup.csv (ephemeral Cloud disk — not durable)' }}",
            "payload": "={{ JSON.stringify({ path: '/tmp/job_applications_backup.csv', rows: $('Read Jobs').all().filter(r => Object.keys(r.json).length > 0).length }) }}"
          },
          "schema": [
            {
              "id": "log_timestamp",
              "displayName": "log_timestamp",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "date",
              "canBeUsedToMatch": true
            },
            {
              "id": "node_name",
              "displayName": "node_name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "event_type",
              "displayName": "event_type",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "message",
              "displayName": "message",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "payload",
              "displayName": "payload",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Daily Midnight": {
      "main": [
        [
          {
            "node": "Read Jobs",
            "type": "main",
            "index": 0
          }
        ]
