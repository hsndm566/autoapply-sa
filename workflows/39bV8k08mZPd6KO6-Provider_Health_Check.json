      "id": "340512e0-16b2-4966-98ca-92619700adbe",
      "name": "Aggregate Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function evaluate(name, j) {\n  var r = j || {};\n  var alive = false;\n  var detail = '';\n  var hasChoices = r.choices && r.choices.length > 0;\n  if (r.id || hasChoices) {\n    alive = true;\n    detail = 'OK';\n  } else {\n    alive = false;\n    var err = r.error || r.message || r;\n    if (err && typeof err === 'object') {\n      detail = String(err.message || err.error || JSON.stringify(err)).slice(0, 200);\n    } else {\n      detail = String(err || 'No valid response').slice(0, 200);\n    }\n  }\n  return { provider: name, alive: alive, detail: detail };\n}\nvar results = [];\ntry { results.push(evaluate('Groq', $('Ping Groq').first().json)); } catch (e) { results.push({ provider: 'Groq', alive: false, detail: 'No output: ' + e.message }); }\ntry { results.push(evaluate('OpenRouter', $('Ping OpenRouter').first().json)); } catch (e) { results.push({ provider: 'OpenRouter', alive: false, detail: 'No output: ' + e.message }); }\ntry { results.push(evaluate('Z.ai', $('Ping Z.ai').first().json)); } catch (e) { results.push({ provider: 'Z.ai', alive: false, detail: 'No output: ' + e.message }); }\nvar aliveCount = 0;\nfor (var i = 0; i < results.length; i++) { if (results[i].alive) aliveCount++; }\nvar lines = ['🩺 AI Provider Health Check — ' + new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC', ''];\nfor (var k = 0; k < results.length; k++) {\n  var em = results[k].alive ? '✅' : '❌';\n  var label = results[k].alive ? 'ALIVE' : 'DEAD';\n  lines.push(em + ' ' + results[k].provider + ': ' + label + (results[k].alive ? '' : ' — ' + results[k].detail));\n}\nlines.push('');\nlines.push(aliveCount + '/' + results.length + ' providers alive.');\nvar summary = lines.join('\\n');\nreturn [{ json: { summary: summary, alive_count: aliveCount, total: results.length, providers: results } }];"
      }
    },
