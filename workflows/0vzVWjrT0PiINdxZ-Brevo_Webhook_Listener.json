    {
      "id": "brevo000-0000-0000-0000-000000000005",
      "name": "Compute Employer Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var rows = $input.all();\nvar domain = $('Classify Event').first().json.domain || '';\nvar now = Date.now();\nvar cutoff = now - (90 * 24 * 60 * 60 * 1000);\nvar sent = 0, replies = 0, interviews = 0;\nfor (var i = 0; i < rows.length; i++) {\n  var r = rows[i].json || {};\n  if (!r || Object.keys(r).length === 0) continue;\n  var pa = r.processed_at ? Date.parse(r.processed_at) : now;\n  if (isNaN(pa)) pa = now;\n  if (pa < cutoff) continue;\n  var st = String(r.status || '').toLowerCase();\n  var fb = String(r.feedback_status || '').toLowerCase();\n  var wasSent = (st === 'sent' || st === 'replied' || st === 'auto_reply' || st === 'interview_invite' || st === 'bounced' || r.applied === true);\n  if (wasSent) sent++;\n  if (fb === 'replied' || st === 'replied') replies++;\n  if (fb === 'interview_invite' || st === 'interview_invite') { replies++; interviews++; }\n}\nvar responses = replies;\nvar rate = sent > 0 ? Math.round((responses / sent) * 1000) / 1000 : 0;\nreturn [{ json: { domain: domain, total_sent: sent, total_replies: replies, total_interviews: interviews, response_rate: rate, updated_ts: new Date().toISOString() } }];"
      }
    },
