    {
      "id": "brevo000-0000-0000-0000-000000000002",
      "name": "Classify Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var body = ($input.first().json && $input.first().json.body) ? $input.first().json.body : ($input.first().json || {});\nvar ev = String(body.event || body.Event || '').toLowerCase();\nvar email = String(body.email || body.From || body.from || body.sender || '').toLowerCase().trim();\nvar m = email.match(/<([^>]+)>/); if (m) email = m[1];\nvar text = String(body.RawTextBody || body.text || body.rawTextBody || body.subject || body.Subject || body.message || '').toLowerCase();\nvar domain = '';\nvar at = email.indexOf('@'); if (at !== -1) domain = email.slice(at + 1);\nvar bounceEvents = ['hard_bounce','soft_bounce','hardbounce','softbounce','bounce','blocked','invalid_email','error'];\nvar isBounce = false; for (var i = 0; i < bounceEvents.length; i++) { if (ev.indexOf(bounceEvents[i]) !== -1) { isBounce = true; break; } }\nvar bounceType = ev.indexOf('soft') !== -1 ? 'soft_bounce' : 'hard_bounce';\nvar autoMarkers = ['out of office','auto-generated','auto generated','automatic reply','autoreply','do not reply','do-not-reply','no longer employed','no longer with','away from my','vacation','thank you for your application','we have received your application','application received'];\nvar interviewKw = ['schedule a call','available for an interview','next steps','interview','set up a meeting','book a time','phone screen','let us talk','let’s talk','arrange a call'];\nvar isAuto = false; for (var a = 0; a < autoMarkers.length; a++) { if (text.indexOf(autoMarkers[a]) !== -1) { isAuto = true; break; } }\nvar isInterview = false; for (var k = 0; k < interviewKw.length; k++) { if (text.indexOf(interviewKw[k]) !== -1) { isInterview = true; break; } }\n// scheduling keyword overrides generic 'thank you' auto marker\nif (isInterview) isAuto = false;\nvar cls = 'ignored';\nif (isBounce) cls = 'bounced';\nelse if (isInterview) cls = 'interview_invite';\nelse if (isAuto) cls = 'auto_reply';\nelse if (email) cls = 'replied';\nvar tgText = '';\nif (cls === 'interview_invite') { tgText = '🎉 Interview invite from ' + (domain || email) + '! Reply to schedule. Tip: use the mock interview feature to prep.'; }\nreturn [{ json: { event_raw: ev, email: email, domain: domain, classification: cls, is_bounce: isBounce, is_interview: (cls === 'interview_invite'), bounce_type: bounceType, tg_text: tgText } }];"
      }
    },
