    {
      "id": "results",
      "name": "Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function check(name){\n  try {\n    const items = $(name).all();\n    const j = (items[0] && items[0].json) || {};\n    if (j.error) return { alive:false, detail: String(typeof j.error==='object'?JSON.stringify(j.error):j.error).slice(0,240) };\n    if (j.choices || j.id || j.output) return { alive:true, detail:'ok' };\n    return { alive:false, detail: JSON.stringify(j).slice(0,240) };\n  } catch(e){ return { alive:false, detail:'no output: '+e.message }; }\n}\nreturn [{ json: { siliconflow: check('Ping SiliconFlow'), cerebras: check('Ping Cerebras'), zai: check('Ping Z.ai') } }];"
      }
    }
  ],
