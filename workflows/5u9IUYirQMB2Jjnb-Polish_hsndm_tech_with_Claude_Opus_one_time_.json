      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst meta = $('Loop Over Files').first().json;\nconst resp = $input.first().json;\nconst raw = resp.content || '';\nlet html;\nif ((resp.encoding || 'base64') === 'base64') {\n  try { html = Buffer.from(raw, 'base64').toString('utf8'); } catch (e) { html = raw; }\n} else {\n  html = raw;\n}\nreturn [{ json: { owner: meta.owner, repo: meta.repo, branch: meta.branch, filePath: meta.filePath, html } }];\n"
      }
