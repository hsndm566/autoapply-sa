      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst meta = $('Loop Over Files').first().json;\nconst resp = $input.first().json;\nfunction collect(o, arr){ if(o==null) return; if(typeof o==='string'){arr.push(o); return;} if(Array.isArray(o)){for(const x of o) collect(x, arr); return;} if(typeof o==='object'){for(const k of Object.keys(o)) collect(o[k], arr);} }\nconst strs = []; collect(resp, strs);\nlet html = (strs.sort((a,b)=>b.length-a.length)[0] || '').trim();\nif (html.startsWith('\\u0060\\u0060\\u0060')) { html = html.replace(/^\\u0060\\u0060\\u0060[a-zA-Z]*\\n?/, '').replace(/\\u0060\\u0060\\u0060\\s*$/, '').trim(); }\nconst startsOk = html.startsWith('<!DOCTYPE html>');\nconst endsOk = html.endsWith('</html>');\nconst bodyOpen = (html.match(/<body[\\s>]/gi) || []).length;\nconst bodyClose = (html.match(/<\\/body>/gi) || []).length;\nconst scriptOpen = (html.match(/<script[\\s>]/gi) || []).length;\nconst scriptClose = (html.match(/<\\/script>/gi) || []).length;\nconst isValid = startsOk && endsOk && bodyOpen >= 1 && bodyOpen === bodyClose && scriptOpen >= 1 && scriptOpen === scriptClose;\nconst reason = 'start=' + startsOk + ' end=' + endsOk + ' body=' + bodyOpen + '/' + bodyClose + ' script=' + scriptOpen + '/' + scriptClose + ' len=' + html.length;\nreturn [{ json: { owner: meta.owner, repo: meta.repo, branch: meta.branch, filePath: meta.filePath, finalHtml: html, isValid, reason, attempt: 1 } }];\n"
      }
    },
