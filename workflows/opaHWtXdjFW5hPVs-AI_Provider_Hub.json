        "jsCode": "var p = $input.first().json || {};\nvar out = [];\nfor (var i = 0; i < p.plan.length; i++) {\n  var prov = p.plan[i];\n  out.push({ json: { provider: prov, model: p.models[prov], task_type: p.task_type, priority: p.priority, max_tokens: p.max_tokens, messages: p.messages, plan_csv: p.plan_csv, request_summary: p.request_summary, order_index: i } });\n}\nreturn out;"
