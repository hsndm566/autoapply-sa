    {
      "id": "70a4d966-cd0f-4934-b0be-3d68e010ab2f",
      "name": "Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        512
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var item = $input.first().json || {};\nvar provider = item.provider;\nvar sd = $getWorkflowStaticData('global');\nvar now = Date.now();\nvar today = new Date().toISOString().slice(0, 10);\nvar available = true; var skip = '';\n// OpenRouter free allowlist (NOTE: OpenRouter :free list churns — review periodically)\nvar OPENROUTER_FREE = ['deepseek/deepseek-r1:free','google/gemma-3-27b-it:free','meta-llama/llama-4-maverick:free','qwen/qwen2.5-vl-7b-instruct:free'];\nvar SILICONFLOW_ALLOW = ['Qwen/Qwen3-8B','deepseek-ai/DeepSeek-R1-Distill-Qwen-7B','deepseek-ai/DeepSeek-OCR'];\nvar model = item.model;\nif (provider === 'openrouter') {\n  if (OPENROUTER_FREE.indexOf(model) === -1) model = OPENROUTER_FREE[0];\n  if (String(model).indexOf(':free') === -1) { available = false; skip = 'model not free'; }\n  if (!sd.openrouter || sd.openrouter.date !== today) sd.openrouter = { date: today, count: 0 };\n  if (sd.openrouter.count >= 200) { available = false; skip = 'openrouter daily 200 reached'; }\n}\nif (provider === 'siliconflow') { if (SILICONFLOW_ALLOW.indexOf(model) === -1) model = SILICONFLOW_ALLOW[0]; }\nvar est = Math.ceil((JSON.stringify(item.messages || []).length) / 4) + (item.max_tokens || 0);\nif (provider === 'cerebras') {\n  if (!sd.cerebras || sd.cerebras.date !== today) sd.cerebras = { date: today, tokens: 0, ts: [] };\n  var kept = []; for (var t = 0; t < sd.cerebras.ts.length; t++) { if (now - sd.cerebras.ts[t] < 60000) kept.push(sd.cerebras.ts[t]); }\n  sd.cerebras.ts = kept;\n  if (sd.cerebras.ts.length >= 5) { available = false; skip = 'cerebras 5/min rate limit'; }\n  else if (sd.cerebras.tokens + est > 900000) { available = false; skip = 'cerebras 900k daily token budget'; }\n}\nvar request_body = { model: model, messages: item.messages, max_tokens: item.max_tokens, temperature: 0.6 };\nif (available) {\n  if (provider === 'openrouter') sd.openrouter.count = (sd.openrouter.count || 0) + 1;\n  if (provider === 'cerebras') sd.cerebras.ts.push(now);\n}\nvar o = Object.assign({}, item, { model: model, request_body: request_body, _available: available, _skip_reason: skip });\nreturn [{ json: o }];"
      }
