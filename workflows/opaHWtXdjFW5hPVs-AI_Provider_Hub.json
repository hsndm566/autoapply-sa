      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var resp = $input.first().json || {};\nvar ctx = $('Preflight').first().json || {};\nvar statusCode = resp.statusCode;\nvar bodyR = resp.body;\nif (bodyR === undefined && resp.choices) { bodyR = resp; }\nvar success = false; var content = ''; var pt = 0; var ct = 0; var errmsg = '';\nif (resp.error) { errmsg = String(resp.error).slice(0, 500); }\nif (typeof statusCode === 'number') { if (statusCode >= 200 && statusCode < 300) success = true; else errmsg = 'HTTP ' + statusCode; }\nelse if (bodyR && bodyR.choices) { success = true; }\ntry { if (bodyR && bodyR.choices && bodyR.choices[0] && bodyR.choices[0].message) content = bodyR.choices[0].message.content || \"\"; } catch (e) {}\ntry { if (bodyR && bodyR.usage) { pt = bodyR.usage.prompt_tokens || 0; ct = bodyR.usage.completion_tokens || 0; } } catch (e) {}\nif (success && (!content || String(content).length === 0)) { success = false; errmsg = errmsg || 'empty content'; }\nvar sd = $getWorkflowStaticData('global');\nif (ctx.provider === 'cerebras' && sd.cerebras) { sd.cerebras.tokens = (sd.cerebras.tokens || 0) + ((pt + ct) || 0); }\nif (!success) { sd['last_error'] = (ctx.provider + ': ' + (errmsg || 'failed')).slice(0, 500); }\nreturn [{ json: { provider: ctx.provider, model: ctx.model, task_type: ctx.task_type, priority: ctx.priority, request_summary: ctx.request_summary, plan_csv: ctx.plan_csv, success: success, content: content, prompt_tokens: pt, completion_tokens: ct, error: errmsg } }];"
