      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var root = $input.first().json || {};\nvar req = root.body || {};\nvar messages = Array.isArray(req.messages) ? req.messages : [];\nvar task_type = String(req.task_type || 'general');\nvar validTasks = ['cv_tailor','script_gen','website_gen','translate','general'];\nif (validTasks.indexOf(task_type) === -1) task_type = 'general';\nvar priority = (req.priority === 'high') ? 'high' : 'normal';\nvar max_tokens = parseInt(req.max_tokens, 10);\nif (!max_tokens || isNaN(max_tokens)) max_tokens = 1500;\nvar valid = messages.length > 0;\nfor (var i = 0; i < messages.length; i++) { if (!messages[i] || messages[i].content === undefined || messages[i].content === null || String(messages[i].content).length === 0) { valid = false; break; } }\nvar plan;\nif (task_type === 'cv_tailor' || priority === 'high') plan = ['cerebras','groq','openrouter','siliconflow','zai'];\nelse if (task_type === 'website_gen') plan = ['openrouter','groq','siliconflow','zai'];\nelse if (task_type === 'script_gen' || task_type === 'translate') plan = ['groq','openrouter','siliconflow','zai'];\nelse plan = ['groq','openrouter','siliconflow','cerebras','zai'];\nvar models = { cerebras: 'gpt-oss-120b', groq: 'llama-3.3-70b-versatile', openrouter: 'deepseek/deepseek-r1:free', siliconflow: 'Qwen/Qwen3-8B', zai: 'glm-4.5-flash' };\nvar summary = task_type + ' | prio=' + priority + ' | msgs=' + messages.length + ' | max=' + max_tokens;\nreturn [{ json: { valid: valid, task_type: task_type, priority: priority, max_tokens: max_tokens, messages: messages, plan: plan, plan_csv: plan.join(\",\"), models: models, request_summary: summary, invalid_reason: valid ? \"\" : \"messages missing or empty\" } }];"
      }
    },
