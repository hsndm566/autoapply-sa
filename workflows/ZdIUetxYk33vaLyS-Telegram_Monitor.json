    {
      "id": "9b44a118-5753-4b96-9cc2-41c8b1b40a8f",
      "name": "Count Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst norm = s => String(s || '').toLowerCase().trim();\nconst newCount = rows.filter(r => norm(r.status) === 'new').length;\nconst pendingCount = rows.filter(r => norm(r.status) === 'pending').length;\nconst chatId = $('Telegram Command').first().json.message.chat.id;\nconst text = ['Job Applications Status', '', 'New: ' + newCount, 'Pending: ' + pendingCount, 'Total tracked: ' + rows.length].join('\\n');\nreturn [{ json: { chatId, text } }];"
      }
    },
