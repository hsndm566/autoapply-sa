    {
      "id": "77c07282-4a80-493e-a049-f84b1cc23b19",
      "name": "Format Last 5 Errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nrows.sort((a, b) => new Date(b.occurred_at || 0).getTime() - new Date(a.occurred_at || 0).getTime());\nconst last5 = rows.slice(0, 5);\nconst chatId = $('Telegram Command').first().json.message.chat.id;\nlet text;\nif (last5.length === 0) {\n  text = 'No errors logged.';\n} else {\n  const lines = ['Last ' + last5.length + ' error(s):', ''];\n  for (const r of last5) {\n    const when = r.occurred_at ? String(r.occurred_at) : 'unknown time';\n    lines.push('• [' + when + '] ' + (r.workflow_name || 'Unknown') + ' @ ' + (r.node_name || 'unknown node'));\n    lines.push('   ' + (r.error_message || 'No message'));\n  }\n  text = lines.join('\\n');\n}\nreturn [{ json: { chatId, text } }];"
      }
    },
