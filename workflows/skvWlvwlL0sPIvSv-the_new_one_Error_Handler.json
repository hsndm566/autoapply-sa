    {
      "name": "Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e = $json || {};\nconst wf = e.workflow || {};\nconst exec = e.execution || {};\nconst err = exec.error || e.error || {};\nconst wfName = wf.name || \"Unknown workflow\";\nconst wfId = wf.id || \"\";\nconst mode = exec.mode || \"\";\nconst lastNode = (exec.lastNodeExecuted) || (err.node && err.node.name) || \"unknown\";\nconst msg = err.message || \"No error message provided\";\nconst stack = err.stack || \"\";\nconst when = new Date().toISOString();\n\nconst subject = \"n8n error: \" + wfName + \" failed at \" + lastNode;\nconst lines = [\n  \"A workflow execution failed.\",\n  \"\",\n  \"Workflow: \" + wfName + \" (\" + wfId + \")\",\n  \"Failed node: \" + lastNode,\n  \"Mode: \" + mode,\n  \"Time: \" + when,\n  \"\",\n  \"Error message:\",\n  msg,\n];\nif (stack) { lines.push(\"\", \"Stack:\", stack); }\nconst body = lines.join(\"\\n\");\nconst htmlBody = lines.join(\"<br>\");\nreturn [{ json: { subject, body, htmlBody } }];"
      },
      "position": [
        224,
        -96
      ],
      "id": "1f02547a-53ef-4e19-853d-fbfcb35ee92c"
    },
    {
      "name": "Send Error Email (Brevo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendInBlueApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sender: { email: 'hasanadam506@gmail.com' }, to: [{ email: 'hasanadam506@gmail.com' }], subject: $json.subject, htmlContent: $json.htmlBody }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "position": [
        448,
        -96
      ],
      "id": "e66a04d3-8240-49f2-a0f8-b6803362892f"
    },
