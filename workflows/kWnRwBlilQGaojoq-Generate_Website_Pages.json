    {
      "id": "d1f60123-6b06-4cfb-9302-6f31c3f3d1b5",
      "name": "Generate Dashboard HTML",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Create dashboard.html for Hasan Adam's job automation dashboard. Use Tailwind CSS CDN, Font Awesome CDN, Chart.js CDN, same design system as the existing site (dark navy background, glassmorphism cards, accent #2563eb). Include:\n- A hero section: 'AI Job Engine – Live Activity'.\n- Four stats cards (Sent Today, Replies, Interviews, Total Sent) with count-up animation.\n- A doughnut chart (Chart.js) showing status breakdown.\n- A recent activity table (last 10 entries).\n- Auto-refresh every 5 minutes, manual refresh button, skeleton loaders.\n- Data from Google Sheets: Sheet ID 1rivD5luGlZqq6MCEUVvlT263OfUKXrzH6cr9cf0nG3A, sheet name Job Applications Log, using gviz/tq endpoint.\n- A navigation header linking to index.html and cv.html.\n- The Julie chatbot widget (bottom-right bubble, sends to https://hsndm566.app.n8n.cloud/webhook/julie-chat).\n- Footer with social links.\n- All JavaScript inline.",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a web developer. Output ONLY the complete HTML code for a page. No explanation."
            }
          ]
        }
      }
    },
