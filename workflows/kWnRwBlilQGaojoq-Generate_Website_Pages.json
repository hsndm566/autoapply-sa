    {
      "id": "f9565b96-42c6-4662-a910-109de934eb2d",
      "name": "Build Dashboard Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        112
      ],
      "parameters": {
        "jsCode": "let html = $('Generate Dashboard HTML').item.json.text || '';\nhtml = html.trim();\n// Strip a leading markdown code fence like ```html and a trailing ```\nhtml = html.replace(/^```[a-zA-Z]*\\s*\\n?/, '').replace(/\\n?```\\s*$/, '').trim();\nconst getResp = $input.item.json || {};\nconst sha = getResp && getResp.sha ? getResp.sha : undefined;\nconst content = Buffer.from(html, 'utf8').toString('base64');\nconst ghBody = { message: 'Add dashboard.html', content, branch: 'main' };\nif (sha) ghBody.sha = sha;\nreturn [{ json: { ghBody } }];"
      }
    },
