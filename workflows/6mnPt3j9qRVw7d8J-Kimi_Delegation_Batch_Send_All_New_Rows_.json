      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var all = $input.all();\nvar out = [];\nfor (var i = 0; i < all.length; i++) {\n  var r = all[i].json || {};\n  var email = (r.contact_email || r.email || '').toString().trim();\n  if (email) { out.push({ json: { row_id: r.id, company: r.company || 'the company', industry: r.industry || 'Engineering', recipient: email, job_description: r.job_description || '' } }); }\n}\nvar total = out.length;\nfor (var k = 0; k < out.length; k++) { out[k].json.total = total; out[k].json.processed_index = k + 1; }\nreturn out;"
      }
    },
