    {
      "id": "1aa01103-5017-46e0-bef8-e599f24886fd",
      "name": "Parse & Split Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first() ? $input.first().json : {};\nlet content = '';\ntry { content = item.choices[0].message.content || ''; } catch (e) { content = ''; }\nlet scenes = [];\ntry {\n  const parsed = JSON.parse(content);\n  if (parsed && Array.isArray(parsed.scenes)) scenes = parsed.scenes;\n} catch (e) { scenes = []; }\nconst body = ($('Webhook').first().json.body) || {};\nif (!scenes.length) {\n  scenes = [{ text: body.topic || '', keyword: body.topic || '' }];\n}\nreturn scenes.map((s, i) => ({ json: {\n  index: i + 1,\n  text: (s && s.text) ? String(s.text) : '',\n  keyword: (s && s.keyword) ? String(s.keyword) : (body.topic || ''),\n  topic: body.topic || '',\n  style: body.style || ''\n} }));"
      }
    },
