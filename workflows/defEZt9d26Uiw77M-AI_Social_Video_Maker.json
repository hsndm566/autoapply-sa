    {
      "id": "af1647f8-2b20-4104-8afd-259e2fd0e916",
      "name": "Extract Clip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const scene = $('Parse & Split Scenes').item.json;\nconst resp = $json || {};\nlet url = '';\ntry {\n  const videos = Array.isArray(resp.videos) ? resp.videos : [];\n  if (videos.length && Array.isArray(videos[0].video_files) && videos[0].video_files.length) {\n    const files = videos[0].video_files.slice().sort((a, b) => (a.width || 999999) - (b.width || 999999));\n    // prefer a portrait file around 720 wide if available, else smallest\n    let chosen = files[0];\n    for (const f of files) { if ((f.height || 0) >= (f.width || 0) && (f.width || 0) >= 540) { chosen = f; break; } }\n    url = chosen.link || files[0].link || '';\n  }\n} catch (e) { url = ''; }\nreturn { json: {\n  index: scene.index,\n  text: scene.text,\n  keyword: scene.keyword,\n  topic: scene.topic,\n  style: scene.style,\n  clip_url: url\n} };"
      }
    },
    {
      "id": "f818317f-cc23-41d4-b4eb-e61ce46be335",
      "name": "Build Edit Specs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst LF = String.fromCharCode(10);\nconst SCENE_LEN = 3;\nconst W = 720, H = 1280;\nconst clips = [];\nconst lines = [];\nlet first = {};\nitems.forEach((it, i) => {\n  const j = it.json || {};\n  if (i === 0) first = j;\n  lines.push(j.text || '');\n  if (j.clip_url) { clips.push({ src: j.clip_url, text: j.text || '', index: i }); }\n});\nconst topic = first.topic || '';\nconst style = first.style || '';\n\n// ---- Shotstack edit (POST /edit/v1/render) ----\nconst ssVideoClips = [];\nconst ssTitleClips = [];\nclips.forEach((c, i) => {\n  const start = i * SCENE_LEN;\n  ssVideoClips.push({ asset: { type: 'video', src: c.src, volume: 0 }, start: start, length: SCENE_LEN, fit: 'cover' });\n  ssTitleClips.push({ asset: { type: 'title', text: c.text, style: 'subtitle', size: 'medium', position: 'bottom' }, start: start, length: SCENE_LEN, transition: { in: 'fade', out: 'fade' } });\n});\nconst shotstack = {\n  timeline: { background: '#000000', tracks: [ { clips: ssTitleClips }, { clips: ssVideoClips } ] },\n  output: { format: 'mp4', fps: 25, size: { width: W, height: H } }\n};\n\n// ---- JSON2Video movie (POST /v2/movies) ----\nconst j2vScenes = clips.map((c) => ({ elements: [\n  { type: 'video', src: c.src, duration: SCENE_LEN, resize: 'cover' },\n  { type: 'text', text: c.text, duration: SCENE_LEN, position: 'bottom-center', 'font-size': 48, color: '#ffffff' }\n] }));\nconst json2video = { resolution: 'custom', width: W, height: H, quality: 'high', scenes: j2vScenes };\n\nreturn [{ json: {\n  shotstack: shotstack,\n  json2video: json2video,\n  topic: topic,\n  style: style,\n  script: lines.map((l, i) => (i + 1) + '. ' + l).join(LF),\n  clip_count: clips.length\n} }];"
      }
    },
